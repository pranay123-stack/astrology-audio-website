# Copy to .env.local and fill in. Never commit real values.
# Values starting with NEXT_PUBLIC_ are sent to the browser and inlined at build time:
# rebuild after changing them.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Astro Cricket"
# Public URL without a trailing slash (used for canonical URLs, sitemap, Open Graph).
# Production: https://your-domain.com (must be set BEFORE the build).
NEXT_PUBLIC_SITE_URL=http://localhost:3460
# IANA timezone for match start times and publication dates.
NEXT_PUBLIC_SITE_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_SITE_LOCALE=en-IN
# "true" hides the whole site from search engines. Use on temporary test deployments
# (e.g. a *.vercel.app address); remove it for the public launch.
# NEXT_PUBLIC_NOINDEX=true

# --- Data backend -----------------------------------------------------------
# "supabase" for production. "local" stores data in .data/ (development/demo only;
# hosting redeploys can wipe its files, and the production server refuses to start in it).
# If unset, Supabase is used when the URL and anon key are both present.
NEXT_PUBLIC_DATA_BACKEND=local

# --- Supabase (required when NEXT_PUBLIC_DATA_BACKEND=supabase) -------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe for the browser; RLS limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY: never prefix with NEXT_PUBLIC_, never expose.
# Used to sign media URLs, issue signed upload URLs and store contact messages.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local-mode admin login (ignored in Supabase mode) ----------------------
# `npm run setup:local` generates all three.
# At least 32 random characters. Changing it signs every admin out.
SESSION_SECRET=
ADMIN_EMAIL=
# scrypt hash from `npm run admin:hash -- 'password'` (never the password itself).
ADMIN_PASSWORD_HASH=
# Folder for the JSON database and uploaded files in local mode.
# LOCAL_DATA_DIR=.data
# The production server refuses to start in local mode unless this is "true".
# Only for trying a production build on your own computer; never set it on a host.
# ALLOW_LOCAL_BACKEND_IN_PRODUCTION=true

# --- Uploads ----------------------------------------------------------------
# Supabase's Free plan accepts files up to 50 MB. On a paid plan you can raise the
# global limit in Supabase (Storage -> Settings) and these values, up to the
# 200 MB audio bucket limit set in the migration.
MAX_AUDIO_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=5
# Client-side pre-check shown to the admin; set it to the same value.
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_MB=50

# --- Premium module ---------------------------------------------------------
# Keep false until pricing and a payment provider are configured. While false,
# premium audio is refused by the server for everyone except administrators.
PREMIUM_ENABLED=false
